# Neon Postgres connection string (server only)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Ably API key (server only) — used to mint channel tokens and publish room events
ABLY_API_KEY=appId.keyId:keySecret

# LiveKit Cloud credentials (server only) — used to mint short-lived A/V tokens
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HMAC secret for hashing opaque participant session tokens (server only)
SESSION_SECRET=replace-with-a-long-random-string

# LiveKit Cloud WebSocket URL (safe to expose to the browser)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Public origin of this app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Frontend: in-browser mock. OFF by default — the UI talks to this app's /api routes.
# Never inferred from a missing URL. Set true only for UI work without DB/Ably/LiveKit.
# NEXT_PUBLIC_USE_MOCK_API=true
